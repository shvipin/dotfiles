# --- DAX / Persistent Memory (PMEM) ---
# (Required to support PKRAM / memory preservation across kexec)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZONE_DEVICE=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_FS_DAX=y
CONFIG_DAX=y
CONFIG_DEV_DAX=y
CONFIG_DEV_DAX_PMEM=y
CONFIG_DEV_DAX_KMEM=y

# --- Kexec Handover (KHO) / PKRAM ---
# CONFIG_PKRAM is not set
CONFIG_MEMBLOCK_KHO_SCRATCH=y
CONFIG_KEXEC_FILE=y
CONFIG_KEXEC_HANDOVER=y
CONFIG_KEXEC_HANDOVER_DEBUG=y
CONFIG_KEXEC_HANDOVER_ENABLE_DEFAULT=y

# --- Live Update Core ---
CONFIG_LIVEUPDATE=y
CONFIG_LIVEUPDATE_TEST=y

# --- Subsystem Live Update ---
# (Only active if the respective subsystems are also enabled)
CONFIG_PCI_LIVEUPDATE=y
# CONFIG_IOMMU_LIVEUPDATE is not set
# CONFIG_VFIO_PCI_LIVEUPDATE is not set
# CONFIG_YENTA is not set
# CONFIG_CARDBUS is not set
