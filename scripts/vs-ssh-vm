#!/bin/bash

SCRIPT_DIR=$(dirname $(realpath ${BASH_SOURCE[0]}))

# Defaults
SSH_KEY="$SCRIPT_DIR/id_testvm_passwordless"
SSH_PORT="2222"
VM_IP="127.0.0.1"
usage() {
    echo "Usage: $0 [-k <ssh_key_private>] [-p <port>] [command...]"
    exit 1
}

while getopts "k:p:" option; do
    case "$option" in
        k) SSH_KEY="$OPTARG" ;;
        p) SSH_PORT="$OPTARG" ;;
        :) echo "Error: Option -${OPTARG} requires an argument." >&2; usage ;;
        ?) echo "Error: Invalid option -${OPTARG}." >&2; usage ;;
    esac
done

shift $((OPTIND - 1))

# Expand tilde in SSH_KEY path safely
SSH_KEY="${SSH_KEY/#\~/$HOME}"
SSH_OPTS="-F /dev/null \
	  -o IdentityAgent=none \
	  -o NoHostAuthenticationForLocalhost=yes \
	  -o StrictHostKeyChecking=no \
	  -o BatchMode=yes \
	  -o IdentitiesOnly=yes \
	  -i $SSH_KEY \
	  -p $SSH_PORT"


# Enforce strict permissions on private key (required by SSH)
if [ -f "$SSH_KEY" ]; then
    chmod 600 "$SSH_KEY" 2>/dev/null || true
fi

env -u SSH_AUTH_SOCK ssh $SSH_OPTS root@$VM_IP "$@"

